{
  "name": "pickup-registration-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-showcase.mjs",
    "build": "tsc -b && vite build --mode docdb-local && npm run build:docdb-server",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:roster": "node scripts/import-roster.mjs",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build:demo": "tsc -b && vite build --mode demo && npm run build:server",
    "generate:demo": "node scripts/generate-demo.mjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/package-function.mjs",
    "dev:server": "vite --host 127.0.0.1 --mode server",
    "mysql:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-mysql.ps1",
    "mysql:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-mysql.ps1 -Stop",
    "build:cloud": "tsc -b && vite build --mode server && npm run build:server",
    "api:local": "node --env-file=.env.local scripts/local-api.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db-admin.mjs migrate",
    "db:init": "node --env-file=.env.local scripts/db-admin.mjs init",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "test:server:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --config playwright.server.config.ts",
    "build:docdb-server": "tsc -p tsconfig.docdb.json && node scripts/package-docdb.mjs",
    "build:docdb-local-tools": "tsc -p tsconfig.docdb-local.json && node scripts/package-docdb-local.mjs",
    "build:docdb": "tsc -b && vite build --mode docdb && npm run build:docdb-server",
    "dev:docdb-local": "vite --host 127.0.0.1 --mode docdb-local",
    "api:docdb-local": "node scripts/local-docdb-api.mjs",
    "test:docdb:e2e": "playwright test --config playwright.docdb.config.ts",
    "dev:docdb-cloud": "vite --host 127.0.0.1 --mode docdb-cloud",
    "build:docdb-cloud": "tsc -b && vite build --mode docdb-cloud",
    "dev:docdb-formal": "vite --host 127.0.0.1 --mode docdb-formal",
    "build:docdb-formal": "tsc -b && vite build --mode docdb-formal"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "3.9.4",
    "@cloudbase/node-sdk": "3.18.3",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
