# Template only. Copy to .env.local; never commit secrets. Frontend has no DB credentials.
VITE_PICKUP_MODE=server
VITE_PICKUP_API=/api/pickup
# Used only by Vite for loopback verification, never embedded in the frontend.
PICKUP_DEV_PROXY=http://127.0.0.1:3001
# Fill from the confirmed database console. No live environment configured here.
PICKUP_TARGET_ENV=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_TLS=true
MYSQL_CA_FILE=
# Cloud function default closed; enable only after approved gateway/network protection.
PICKUP_HTTP_ENABLED=false
# Document DB candidate only; never embed these server fields in a webpage.
PICKUP_DOCDB_ENV=
PICKUP_DOCDB_PREFIX=
PICKUP_DOCDB_HTTP_ENABLED=false
# Loopback document simulator; separate from the existing MySQL proxy.
PICKUP_DOCDB_DEV_PROXY=http://127.0.0.1:3003
# Formal function only: JSON array of exactly five UIDs; server environment only.
# Leave blank in the repository; fail closed until an approved deployment supplies it.
PICKUP_ALLOWED_UIDS=
# Copy these public connection fields to ignored .env.docdb-formal.local.
# Point to a separate formal-entry Event function, never the public trial function.
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_PUBLISHABLE_KEY=
VITE_CLOUDBASE_PICKUP_FUNCTION=
VITE_CLOUDBASE_REGION=ap-shanghai

# Public showcase: cloud connections require a deliberate opt-in.
PICKUP_ENABLE_CLOUD=false
